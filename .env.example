# Copy to .env.local. Local values come from `npm run db:status`.
# For production use your Supabase project (ref jjaxqfhvswdjjydzqvud): Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-here
# Public Play Store listing the QR / store button points to.
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.mednotes.elibrary
# Google's own sign-in button on the website (Google Cloud → Credentials → OAuth client ID, type "Web application").
# Leave it out to use the normal redirect sign-in everywhere.
VITE_GOOGLE_CLIENT_ID=
